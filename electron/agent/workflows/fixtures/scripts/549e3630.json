      "params": {},
      "actions": [
        {
          "cmd": "scroll down 400",
          "waitBefore": "--text \"JavaScript\"",
          "assert": "--fn \"window.scrollY >= 300\"",
          "settleMs": 800,
          "narrationAnchor": 0
        },
        {
