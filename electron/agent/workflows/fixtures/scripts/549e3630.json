        {
          "cmd": "find role button hover --name \"JavaScriptJS\" --exact",
          "assert": "--fn 'document.querySelector(\".menu__tab-button:hover\")?.textContent.includes(\"JavaScript\")'",
          "settleMs": 500
        },
        {
          "cmd": "find role button hover --name \"Web APIs\" --exact",
          "assert": "--fn 'document.querySelector(\".menu__tab-button:hover\")?.textContent.includes(\"Web APIs\")'",
          "settleMs": 500
        },
        {
          "cmd": "find role button hover --name \"Learn\" --exact",
          "assert": "--fn 'document.querySelector(\".menu__tab-button:hover\")?.textContent.includes(\"Learn\")'",
          "settleMs": 500
        },
        {
          "cmd": "find role button hover --name \"Tools\" --exact",
